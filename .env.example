# Copy to .env.local for development. In production these come from the host's env file.

# Database: Supabase Postgres (local stack from `pnpm db:up` listens on 54622).
# On hosted Supabase use the pooled connection (port 6543, ?pgbouncer=true) for DATABASE_URL
# and the direct connection (port 5432) for DIRECT_URL, which migrations use.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54622/chatua_dev
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54622/chatua_dev

# Public site URL, no trailing slash (used for canonical links, sitemap and Open Graph). Read at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Storage for product photos (bucket "product-images"). Server-only; never expose the secret key.
# Without it, products use the drawn placeholder illustration.
SUPABASE_URL=http://127.0.0.1:54621
SUPABASE_SECRET_KEY=

# Payments. PAYMENT_PROVIDER: razorpay | mock | (empty = Cash on Delivery only).
# "mock" simulates online payment for testing and must never be used for real customers.
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# Admin (single credential in v1). Hash with: pnpm admin:hash '<password>'
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=

# Support and analytics (optional; features hide themselves when empty)
NEXT_PUBLIC_WHATSAPP_NUMBER=       # digits with country code, e.g. 919XXXXXXXXX
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=      # e.g. chatua.in
